POSTGRES_DB=appinsight
POSTGRES_USER=appinsight
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgresql+psycopg://appinsight:change-me-to-a-long-random-password@db:5432/appinsight
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173
# 0 significa sin límite artificial por región (solo las reseñas que Google Play exponga).
MAX_REVIEWS_PER_REGION=0
SCRAPING_DELAY_SECONDS=1.2
